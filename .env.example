CONTACT_INBOX=fabianlema@arjovi.com

# Resend (https://resend.com) — emails you when someone submits the contact form.
# Until arjovi.com is verified in Resend, use their test sender below.
RESEND_API_KEY=
EMAIL_FROM=Arjovi Solutions <beth.t@example.com>

# Pooled URL for the Next.js app (Vercel + Neon).
# Local: npx vercel env pull .env.local
# That command pulls the Development environment (not Preview).
DATABASE_URL=postgresql://

# Quotes tool (unlisted /quotes). Set a strong password.
QUOTE_PASSWORD=
QUOTE_AUTH_SECRET=

# OpenAI — used to draft quotes from the chat.
OPENAI_API_KEY=
